{
  "name": "hatefaroma-back",
  "version": "1.0.0",
  "description": "HatefAroma Backend - NestJS 11 & MongoDB API",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
